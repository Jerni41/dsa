#1
import numpy as np
import matplotlib.pyplot as plt

np.random.seed(42)

# Параметры распределения
mu = np.array([0.0, 0.0])           
sigma = np.array([1.0, 1.5])        

# Генерация 100 точек размерности 2
X = np.random.normal(loc=mu, scale=sigma, size=(100, 2))

# Радиус окружности, содержащей 0.99 всех точек (по расстоянию от центра)
distances = np.sqrt(((X - mu) / sigma) ** 2).sum(axis=1)  
r99 = np.quantile(np.sqrt(((X - mu) ** 2).sum(axis=1)), 0.99)
r3sigma = 3 * np.mean(sigma)  # ~ 3 сигмы

fig, ax = plt.subplots(figsize=(8, 8))

# Точки
ax.scatter(X[:, 0], X[:, 1], alpha=0.6, label='Точки')
# Центр отдельным цветом
ax.scatter(*mu, color='red', s=120, marker='X', zorder=5, label='Центр (μ)')


circle99 = plt.Circle(mu, r99, color='green', fill=False, linewidth=2,
                      label=f'99% точек (r={r99:.2f})')

circle3s = plt.Circle(mu, r3sigma, color='orange', fill=False,
                      linestyle='--', linewidth=2,
                      label=f'3σ (r={r3sigma:.2f})')

ax.add_patch(circle99)
ax.add_patch(circle3s)
ax.set_aspect('equal')
ax.legend()
ax.set_title('Правило трёх сигм')
plt.show()

#2
fig, axes = plt.subplots(1, 2, figsize=(12, 4))

for i in range(2):
    ax = axes[i]
    data = X[:, i]
    # Гистограмма
    ax.hist(data, bins=10, density=True, alpha=0.6, color='steelblue',
            edgecolor='black', label='Гистограмма')
    # Плотность по гистограмме (аппроксимация KDE через нормальное распределение)
    from scipy.stats import norm
    xs = np.linspace(data.min(), data.max(), 200)
    ax.plot(xs, norm.pdf(xs, loc=data.mean(), sd=data.std(ddof=1)),
            color='red', linewidth=2, label='Плотность')
    ax.set_title(f'Признак {i+1}')
    ax.legend()

plt.tight_layout()
plt.show()


#3
from sklearn.datasets import load_iris

iris = load_iris()
data = iris.data
feature_names = iris.feature_names
corr = np.corrcoef(data.T)

fig, ax = plt.subplots(figsize=(10, 8))

# Кастомная цветовая карта: красный - обратная, белый - 0, зелёный - прямая
from matplotlib.colors import LinearSegmentedColormap
cmap = LinearSegmentedColormap.from_list('rg', ['red', 'white', 'green'])

im = ax.imshow(corr, cmap=cmap, vmin=-1, vmax=1)

# Подписи
ax.set_xticks(np.arange(len(feature_names)))
ax.set_yticks(np.arange(len(feature_names)))
ax.set_xticklabels(feature_names, rotation=45, ha='right')
ax.set_yticklabels(feature_names)

# Значения в ячейках
for i in range(len(feature_names)):
    for j in range(len(feature_names)):
        ax.text(j, i, f'{corr[i, j]:.2f}', ha='center', va='center',
                color='black', fontsize=10)

plt.colorbar(im, ax=ax)
ax.set_title('Корреляции признаков Ирисов Фишера')
plt.tight_layout()
plt.show()


#4
import seaborn as sns
import pandas as pd

df = pd.DataFrame(data, columns=feature_names)
corr_df = df.corr()

fig, ax = plt.subplots(figsize=(10, 8))
sns.heatmap(corr_df, annot=True, fmt='.2f', cmap='RdYlGn',
            vmin=-1, vmax=1, center=0,
            square=True, linewidths=0.5, ax=ax,
            cbar_kws={'label': 'Корреляция'})

ax.set_title('Корреляции признаков Ирисов Фишера (seaborn)')
plt.tight_layout()
plt.show()
